# Gemini API Credentials (required for live LLM planning & adjudication)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Concurrency Control (default: 3)
LLM_MAX_CONCURRENCY=3

# Database configuration
AGENTFLOW_DB_PATH=agentflow.db

# Optional Search API Keys (DDGS used by default without keys)
# BRAVE_SEARCH_API_KEY=
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_CSE_ID=
